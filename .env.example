# ──────────────────────────────────────────────
# Thinkiac — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────

# === LLM Provider (Primary) ===
# Choose one provider: openrouter | openai | ollama
AGENT_LLM_PROVIDER=openrouter

# API Key for the LLM provider
AGENT_LLM_API_KEY=sk-your-key-here

# Model name (default: gpt-4o-mini for OpenRouter)
AGENT_LLM_MODEL=gpt-4o-mini

# Base URL (optional — only if using a custom endpoint)
# AGENT_LLM_BASE_URL=https://openrouter.ai/api/v1

# === Moondream (Vision AI) ===
# API key for Moondream image captioning/querying
MOONDREAM_API_KEY=your-moondream-key

# === Router (API Routing) ===
# Keys for internal API routing
ROUTER_API_KEY=your-router-key

# === Server ===
# Port the Agent server runs on
PORT=5040

# Host to bind to
HOST=0.0.0.0

# === OAuth (Optional) ===
# Google OAuth credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# GitHub OAuth credentials
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Meta (Facebook) OAuth credentials
# META_CLIENT_ID=
# META_CLIENT_SECRET=

# === Auth (login/cadastro) ===
# Conta admin criada automaticamente no primeiro boot (gera convites)
AUTH_ENV_ADMIN_EMAIL=admin@admin.com
AUTH_ENV_ADMIN_PASSWORD=change-me
# Duração da sessão em milissegundos (padrão: 24h)
AUTH_ENV_SESSION_DURATION_MS=86400000

# Login com Google. O client é do tipo "Web application" no Google Cloud, e o
# redirect URI cadastrado lá precisa bater exatamente com:
#   https://<CLOUD_ENV_THINKIAC_DOMAIN>/auth/google/callback
AUTH_ENV_GOOGLE_CLIENT_ID=
AUTH_ENV_GOOGLE_CLIENT_SECRET=
# =0 desliga a vinculação automática de conta Google a conta existente de
# mesmo e-mail (a vinculação só ocorre com email_verified=true do Google).
AUTH_ENV_GOOGLE_AUTOLINK=1
# =1 emite o cookie de sessão sem a flag Secure. Só para desenvolvimento
# local em http — em produção deixe desligado.
AUTH_ENV_INSECURE_COOKIES=0

# Confirmação de e-mail para cadastros com senha. O remetente precisa estar
# previamente reservado no Project Mail Gateway com o mailboxId informado.
AUTH_EMAIL_GATEWAY_URL=http://127.0.0.1:5040/project-mail-gateway
AUTH_EMAIL_GATEWAY_TOKEN=
AUTH_EMAIL_MAILBOX_ID=
AUTH_EMAIL_FROM=auth@thinkiac.cloud

# Warm-up pós-provisionamento: depois do container responder, o backend
# ainda chama a rota real de destino (via SSO) até ela renderizar de
# verdade, antes de liberar o botão "Ir" pro usuário — evita que o primeiro
# build (sob demanda) da página caia no colo de quem acabou de se cadastrar.
# Orçamento total de tentativas (ms); esgotado, libera "ready" mesmo assim.
AUTH_ENV_WARMUP_TIMEOUT_MS=60000
# Intervalo entre tentativas (ms)
AUTH_ENV_WARMUP_INTERVAL_MS=3000
# Timeout de cada tentativa (ms) — generoso pq cobre um build a frio
AUTH_ENV_WARMUP_ATTEMPT_TIMEOUT_MS=25000

# === Cloud (provisionamento de instância por usuário) ===
# Domínio raiz: cada usuário vira <username>.CLOUD_ENV_THINKIAC_DOMAIN
CLOUD_ENV_THINKIAC_DOMAIN=thinkiac.cloud
# Imagem Docker mínima buildada via apps/runtime/Dockerfile.minimal
# (scripts/deploy-gateway-runtime-image.sh builda e taggeia no servidor)
CLOUD_ENV_TENANT_IMAGE=registry.thinkiac.space/thinkiac/runtime-minimal@sha256:37ac1bbe58610fb0e0f250210adddfeba02f11914752023672e91cee91ae920b
CLOUD_ENV_GATEWAY_URL=http://172.22.0.1:5040
# Store central usada pelo Package Runtime para resolver releases aprovadas.
# É transmitida ao tenant como THINKIAC_STORE_URL; mantenha HTTPS em produção.
CLOUD_ENV_STORE_URL=https://thinkiac.cloud

# Segredo compartilhado com CADA container de tenant (passado como env var
# na criação via InfraKit) — assina o token de SSO que deixa o dono cair
# autenticado na própria instância sem redigitar senha. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLOUD_ENV_SSO_SECRET=change-me

# Portainer (API usada pelo InfraKit para criar o container por usuário)
CLOUD_ENV_PORTAINER_URL=http://localhost:9000
CLOUD_ENV_PORTAINER_USER=
CLOUD_ENV_PORTAINER_PASS=

# Nginx Proxy Manager (API usada pelo InfraKit para expor o subdomínio)
CLOUD_ENV_NGINX_PM_URL=http://localhost:81
CLOUD_ENV_NGINX_PM_EMAIL=
CLOUD_ENV_NGINX_PM_PASS=

# === Scale-to-zero das instâncias Free ===
# Uma instância Free cai depois de 1h sem nenhuma request e volta sozinha no
# acesso seguinte. Instância paga (e a do admin) nunca é parada.
#
# Ligar é definir CLOUD_ENV_WAKER_HOST: com ele, todo proxy host criado no NPM
# passa a apontar para o waker deste gateway em vez de ir direto no container
# do tenant — é o waker que segura a request, sobe o container e faz o proxy.
# Sem ele, nada sobe e nada é parado (comportamento anterior, intacto).
#
# Ordem para ligar numa instalação que já existe:
#   1. CLOUD_ENV_WAKER_HOST = como o container do NPM alcança este gateway.
#      Com o gateway rodando no host (o caso desta instalação), é o IP do
#      gateway da rede `proxy` — o mesmo endereço que CLOUD_ENV_BILLING_URL já
#      usa. Descubra com:
#        docker inspect npm -f '{{(index .NetworkSettings.Networks "proxy").Gateway}}'
#   2. reinicie e chame POST /cloud/scale-zero/adopt uma vez: é o que reaponta
#      os proxy hosts dos tenants que já existiam. Sem esse passo eles seguem
#      apontando direto para o container e cairiam em 502 ao serem parados.
# Confira em GET /cloud/scale-zero.
#
# CLOUD_ENV_PROXY_CONTAINER continua sendo o "npm": é ele que dispara a criação
# das redes isoladas por tenant. Só troque para o container do waker se um dia
# o waker passar a rodar DENTRO do Docker — aí é ele que precisa estar nessas
# redes. No host, o waker alcança os containers pelo IP da bridge, roteável.
#
# Os valores em uso ficam em packages/cloud/.env (convenção de .env por pacote).
CLOUD_ENV_WAKER_HOST=
CLOUD_ENV_WAKER_PORT=8090
# Ociosidade até a instância free cair (default 1h) e período da varredura.
CLOUD_ENV_SCALE_ZERO_IDLE_MS=3600000
CLOUD_ENV_SCALE_ZERO_REAP_INTERVAL_MS=300000

# === Storage Mesh (MinIO privado) ===
# O processo central provisiona um bucket e uma credencial mínima por tenant.
# Use o endpoint privado da API S3 (normalmente porta 9000), nunca o Console
# (9001) nem o domínio público. Credenciais reais ficam em packages/cloud/.env
# ou no EnvironmentFile do serviço, nunca neste arquivo.
THINKIAC_S3_ENDPOINT=http://10.10.1.5:9000
THINKIAC_S3_REGION=us-east-1
THINKIAC_S3_ADMIN_ACCESS_KEY=
THINKIAC_S3_ADMIN_SECRET_KEY=
THINKIAC_S3_TENANT_SECRET_KEY=
THINKIAC_S3_MC_PATH=/usr/local/bin/minio-mc

# === Billing (proxy de LLM padrão + créditos pré-pagos) ===
# Chave real do OpenRouter — nunca sai do processo do gateway. Todo tenant
# usa o pool "thinkiac" (packages/agent/llm) que aponta pro proxy abaixo,
# autenticado por um token por-tenant, não por essa chave diretamente.
BILLING_ENV_OPENROUTER_KEY=
# Estúdio de Vídeo: TTS remoto é opcional. Sem estas chaves, Edge TTS continua local.
VIDEO_OPENROUTER_TTS_API_KEY=
VIDEO_HEYGEN_VOICE_TURBO_BRIDGE_URL=
VIDEO_HEYGEN_VOICE_TURBO_BRIDGE_TOKEN=
# Access token do Mercado Pago (Checkout Pro) — recarga de créditos.
BILLING_ENV_MERCADOPAGO_ACCESS_TOKEN=
# Câmbio manual USD->BRL usado só na hora de converter uma recarga em BRL
# pra créditos em micro-USD. Sem API de câmbio ao vivo no v1.
BILLING_ENV_USD_BRL_RATE=5.5
# Markup sobre o custo real repassado pelo OpenRouter.
BILLING_ENV_MARKUP_PERCENT=50
# Créditos grátis (em micro-USD; 1_000_000 = US$1) concedidos assim que a
# provisão do tenant termina com sucesso.
BILLING_ENV_SIGNUP_TRIAL_MICROS=1000000
# === Docker Registry (packages/docker-registry) ===
# A frota puxa a imagem do tenant daqui em vez de buildá-la na VPS (o
# Dockerfile.minimal compila nativos e não cabe numa caixa de 477 MB).
# Onde ficam blobs e manifests. Precisa de disco para ~2 tags simultâneas.
DOCKER_REGISTRY_ENV_STORAGE_ROOT=/var/lib/thinkiac/registry
# Duas credenciais de propósito: a de leitura vive no `docker login` de TODA
# VPS da frota, então não pode ser a mesma que autoriza publicar. Sem as
# quatro variáveis o registry recusa tudo, inclusive leitura.
DOCKER_REGISTRY_ENV_PULL_USER=fleet
DOCKER_REGISTRY_ENV_PULL_PASSWORD=
DOCKER_REGISTRY_ENV_PUSH_USER=builder
DOCKER_REGISTRY_ENV_PUSH_PASSWORD=

# === Registry consumido pela frota (packages/cloud + packages/vps) ===
# Host do registry como aparece na tag da imagem. Definido, todo pull de host
# passa a mandar a credencial abaixo no X-Registry-Auth — a VPS não precisa de
# `docker login` nem guarda segredo em disco, o que a torna descartável.
# Ausente => só imagem pública.
CLOUD_ENV_REGISTRY_URL=
CLOUD_ENV_REGISTRY_PULL_USER=fleet
CLOUD_ENV_REGISTRY_PULL_PASSWORD=
# Imagem corrente do tenant. Trocar aqui + reiniciar faz a frota inteira puxar
# a nova na próxima reposição de estoque (ensureCurrentImage), e o estoque na
# imagem velha é descartado sozinho.
CLOUD_ENV_TENANT_IMAGE=

# === Auto-cadastro de VPS (packages/vps) ===
# Segredo que autoriza uma máquina recém-instalada a entrar na frota pelo
# ops/vps-bootstrap.sh (POST /vps/enroll). Diferente do agent-token: aquele
# autoriza o control plane a mandar em agents, este autoriza uma máquina
# desconhecida a se cadastrar. Sem ele a rota responde 503 (fail-closed).
# Alternativa ao env: o arquivo packages/vps/enroll-token.
VPS_ENV_ENROLL_TOKEN=
