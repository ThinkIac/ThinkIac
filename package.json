{
  "name": "thinkiac",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "think": "bin/think.js",
    "thinkiac": "bin/thinkiac.js"
  },
  "scripts": {
    "start": "node index.js --supervisor start",
    "start:runtime": "node index.js",
    "start:foreground": "node index.js --supervisor run",
    "profile:install": "node index.js --install-only",
    "profile:update": "node index.js --install-only --update",
    "build": "npm --prefix vendor/packages/logos run build",
    "test": "node --test launcher/*.test.mjs",
    "test:all": "npm test",
    "test:runner": "npm test",
    "prepare": "npm run build",
    "package:runtime": "node scripts/package-runtime.mjs",
    "package:runtime:win": "node scripts/package-runtime-windows.mjs"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^22",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/ws": "^8.5.10",
    "archiver": "^8.0.0",
    "logos": "file:vendor/packages/logos"
  }
}
