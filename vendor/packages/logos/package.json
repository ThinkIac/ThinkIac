{
  "name": "logos",
  "version": "2.0.0",
  "description": "L\u00f3gos \u2014 a small launcher and compatibility protocol for externally composed Node.js runtimes.",
  "keywords": [
    "runtime",
    "logos",
    "launcher",
    "modules",
    "protocol",
    "composition"
  ],
  "license": "MIT",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "logos": "dist/src/cli/index.js",
    "thinkiac": "dist/src/cli/index.js",
    "think": "dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:independent": "node tests/independent-distribution.test.cjs"
  },
  "peerDependencies": {
    "scriba": "*"
  },
  "peerDependenciesMeta": {
    "scriba": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "logostype": "github:ThinkIac/LogosType#c67e0cc33ff5ab759d65a7ff512a440681dd3352"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
