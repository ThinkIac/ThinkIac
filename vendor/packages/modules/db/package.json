{
  "name": "@thinkiac/module-db",
  "version": "0.1.0",
  "description": "Reusable multi-tenant Scriba database lifecycle",
  "main": "index.cjs",
  "files": [
    "*.cjs",
    "*.d.cts",
    "README.md",
    "test"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs"
  },
  "peerDependencies": {
    "scriba": "*"
  },
  "peerDependenciesMeta": {
    "scriba": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "@thinkiac/module-runtime-compat": "file:../runtime-compat"
  },
  "runtime": {
    "role": "module",
    "entry": "index.cjs"
  }
}
